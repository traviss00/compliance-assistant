# Environment Configuration
# Copy this file to .env and fill in values (optional)

# LLM Provider Selection
# ============================================================================
# Which LLM provider to use for finding summaries
# Options: "openai" | "huggingface" | (leave empty for rule-based fallback)
# Default: empty (system works without any LLM, uses rule-based summary)
LLM_PROVIDER=huggingface

# OpenAI Configuration (required if LLM_PROVIDER=openai)
# ============================================================================
# API key for OpenAI models (GPT-4, GPT-3.5-turbo, etc.)
# Get from: https://platform.openai.com/api-keys
# Note: Requires valid billing/credits on your OpenAI account
OPENAI_API_KEY=

# Hugging Face Configuration (required if LLM_PROVIDER=huggingface)
# ============================================================================
# API key for Hugging Face Inference API
# Get from: https://huggingface.co/settings/tokens
# Free pooled inference API or premium dedicated endpoints
HUGGINGFACE_API_KEY=hf_your-token-here

# Logging Configuration (Optional)
# ============================================================================
# LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Example Configurations
# ============================================================================
# Use OpenAI (GPT-3.5-turbo):
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-your-key-here
#
# Use Hugging Face (Llama 2):
#   LLM_PROVIDER=huggingface
#   HUGGINGFACE_API_KEY=hf-your-key-here
#
# Use rule-based fallback (no external API):
#   LLM_PROVIDER=
#   (leave API keys empty)
